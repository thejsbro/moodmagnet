# Neon pooled connection — used by the app at runtime
# Format: postgres://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=""

# Neon direct connection — used by Prisma CLI (migrate, db push)
# Format: postgres://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL=""
